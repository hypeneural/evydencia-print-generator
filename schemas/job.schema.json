{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evydencia.local/schemas/job.schema.json",
  "title": "EVYDÊNCIA Render Job",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "template_id",
    "template_version",
    "sources",
    "slot_edits"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "template_id": {
      "type": "string",
      "minLength": 1
    },
    "template_version": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "slot_edits": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "pan_x_norm",
          "pan_y_norm",
          "scale",
          "rotation_deg"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "pan_x_norm": {
            "type": "number",
            "description": "ADR-011: [-1, 1] along the rotated photo x axis; 0 = centered, ±1 = edge flush with slot."
          },
          "pan_y_norm": {
            "type": "number",
            "description": "ADR-011: [-1, 1] along the rotated photo y axis; 0 = centered, ±1 = edge flush with slot."
          },
          "scale": {
            "type": "number",
            "minimum": 1,
            "description": "ADR-011: multiplier over the rotation-aware cover scale; 1 = minimum cover, never reveals empty area."
          },
          "rotation_deg": {
            "type": "number",
            "description": "ADR-011: clockwise-positive on screen; normalized to [-180, 180) by the domain.",
            "minimum": -360,
            "maximum": 360
          }
        }
      }
    }
  }
}
